# =========================================================================
# LIS Enterprise Deployment Configuration
# Copy this file to '.env' and populate with local server credentials.
# =========================================================================

# Django Core Parameters
SECRET_KEY=django-insecure-your-secret-key-placeholder-for-interview-submission
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (SQLite default, can be modified for PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3

# Security Settings for Production (Set to True in actual deployment)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Django REST Framework (SimpleJWT) Token Lifespans
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
